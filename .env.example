PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Si defines varios orígenes, separa por comas
# CORS_ORIGIN=http://localhost:5173,https://tu-frontend.pages.dev

# En producción (Render), puedes usar DATABASE_URL en vez de DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD
DATABASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=lawn_service
DB_USER=postgres
DB_PASSWORD=postgres
DB_LOGGING=false
DB_SYNC=false
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=change_this_super_secret_key
JWT_EXPIRES_IN=1d

OWNER_BOOTSTRAP_KEY=change_this_bootstrap_key

RESEND_API_KEY=
RESEND_FROM=no-reply@yourdomain.com
RESEND_TO=owner@example.com

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

UPLOAD_DIR=uploads
