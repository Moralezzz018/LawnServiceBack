PORT=4001
NODE_ENV=production
CORS_ORIGIN=https://tu-dominio-frontend.com,https://tu-proyecto.pages.dev

# Opción recomendada en Render: usa DATABASE_URL (si está presente, tiene prioridad)
DATABASE_URL=

DB_HOST=tu-host-db
DB_PORT=5432
DB_NAME=lawn_service
DB_USER=tu-usuario-db
DB_PASSWORD=tu-password-db
DB_LOGGING=false
DB_SYNC=false
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRET_LARGO_Y_UNICO
JWT_EXPIRES_IN=1d

OWNER_BOOTSTRAP_KEY=CAMBIA_ESTO_POR_UN_TOKEN_SEGURO

# Configura SOLO UNO de los dos proveedores de email (Resend o SMTP)
RESEND_API_KEY=
RESEND_FROM=no-reply@tu-dominio.com
RESEND_TO=owner@tu-dominio.com

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Recomendado en producción: ruta persistente o volumen montado
UPLOAD_DIR=/var/data/uploads
